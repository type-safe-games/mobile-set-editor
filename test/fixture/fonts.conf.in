<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- Generated by CMake: tests see only the fixture's bundled fonts, so renders don't depend on system fonts. -->
<fontconfig>
  <dir>@FIXTURE_FONTS_DIR@</dir>
  <cachedir>@FIXTURE_FONT_CACHE_DIR@</cachedir>
</fontconfig>
